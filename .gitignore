# Runtime state — never committed
#
# `data/` holds rooms.json, and a room record carries its owner token: whoever
# reads it can drive that room. Media under it is large and reconstructable.
data/

# Pid files and the throwaway browser profiles from scripts/local-viewers.sh
# (782 MB of Chromium user data).
run/

# Caddy access logs and the node control log: per-request IPs, peer ids, bytes.
logs/

# Legacy single-stream HLS output from the first experiments.
hls/

# Measurement rounds: access logs with peer ids and LAN addresses, plus the
# sampled JSON. Regenerated by scripts/measure-round.sh; the distilled numbers
# live in report/.
rounds/

# Dependencies and build artefacts
node_modules/
web/player.js.map

# Local environment overrides (keys, base URLs)
.env
.env.*
certs/
