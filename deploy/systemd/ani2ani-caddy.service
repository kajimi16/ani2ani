[Unit]
Description=ani2ani edge (Caddy, automatic HTTPS)
After=network-online.target ani2ani-node.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/ani2ani
EnvironmentFile=-/srv/ani2ani/.env
ExecStart=/usr/local/bin/caddy run --config caddy/Caddyfile.public --adapter caddyfile
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
