# 校内机器 → 边缘 VPS 的反向隧道。放在校内那台机器上。
#
# 需要 /srv/ani2ani-tunnel.env（见 deploy/tunnel.env.example），并在 VPS 的
# sshd_config 里允许 GatewayPorts 关闭状态下的回环转发（默认即可）。
[Unit]
Description=ani2ani reverse tunnel to edge VPS
After=network-online.target ani2ani-node.service
Wants=network-online.target ani2ani-node.service

[Service]
Type=simple
EnvironmentFile=/srv/ani2ani-tunnel.env
ExecStart=/usr/bin/autossh -M 0 -N -T \
  -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new \
  -R 127.0.0.1:18080:127.0.0.1:8080 \
  -p $EDGE_SSH_PORT $EDGE_USER@$EDGE_HOST
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
