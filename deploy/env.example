# /srv/ani2ani/.env —— systemd 会读取
SITE_ADDRESS=ani2.kajimi.cc
ACME_EMAIL=you@example.com
ROOM_DATA_DIR=/srv/ani2ani/data
ROOM_MEDIA_ROOT=/srv/ani2ani/data/rooms
ROOM_TRANSCODE_CONCURRENCY=1
ROOM_MAX_COUNT=8
ROOM_DISK_RESERVE_MB=2048
# 校内镜像（HTTPS，否则 HTTPS 页面会被混合内容拦掉）
MEDIA_MIRRORS=https://ani-lan.kajimi.cc:8443
